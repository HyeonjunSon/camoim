# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env
server/.env

# Seed account credentials (for the community migration) — never commit
seed-accounts.env
server/seed-accounts.env

# Post list used during the community migration (temporary)
server/scripts/posts*.json
# Pre-issued JWTs for seed accounts — never commit
server/scripts/seed-tokens.json
# Drip upload logs and state (temporary)
server/scripts/*.log
server/scripts/posts-drip-state.json

# claude
.claude/

# IDE
.vscode/

# session handoff (local notes — not committed)
HANDOFF.md

# temp
.text

# Server upload cache (Cloudinary is used; the local folder is legacy)
server/uploads/*
!server/uploads/.gitkeep

# Personal interview prep notes — kept out of the public repo
INTERVIEW-PREP.ko.md

# test coverage
coverage/
server/coverage/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Local operational scripts — not committed (local only)
server/scripts/*eed*.js
server/scripts/drip*.js
server/scripts/editExchangePosts.js

# IDE workspace files (personal)
*.code-workspace
