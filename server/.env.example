# Template for server/.env — never commit the real .env (it is in .gitignore).
# On Railway the same keys live in the project's Variables.

# ── MongoDB ────────────────────────────────────────────────
# Local: mongodb://127.0.0.1:27017/cahanin
# Production: the MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/cahanin

# ── Auth ───────────────────────────────────────────────────
# A 64-character random string: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ── Image storage (Cloudinary) ─────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (Resend HTTPS API — Railway blocks SMTP) ─────────
RESEND_API_KEY=
MAIL_FROM=CaMoim <no-reply@camoimapp.com>

# ── Social login — Apple (Sign in with Apple) ──────────────
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# The .p8 key contents, on one line with newlines escaped as \n
APPLE_PRIVATE_KEY=

# ── Social login — Google ──────────────────────────────────
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=

# ── Optional ───────────────────────────────────────────────
# Injected by Railway. Leave empty locally to use port 4000
PORT=
# Only needed once a web client exists. Empty allows every origin (native-only assumption)
SOCKET_CORS_ORIGINS=
