# server/.env 템플릿 — 실제 값이 든 .env는 커밋 금지 (.gitignore에 포함됨)
# Railway에서는 같은 키들을 Variables에 설정한다.

# ── MongoDB ────────────────────────────────────────────────
# 로컬: mongodb://127.0.0.1:27017/cahanin
# 운영: MongoDB Atlas 연결 문자열
MONGODB_URI=mongodb://127.0.0.1:27017/cahanin

# ── 인증 ───────────────────────────────────────────────────
# 64자 랜덤 문자열 권장: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ── 이미지 저장소 (Cloudinary) ─────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── 이메일 (Resend HTTPS API — SMTP는 Railway가 차단) ──────
RESEND_API_KEY=
MAIL_FROM=CaMoim <no-reply@camoimapp.com>

# ── 소셜 로그인 — Apple (Sign in with Apple) ───────────────
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# .p8 키 내용. 줄바꿈은 \n으로 이스케이프해서 한 줄로 넣는다
APPLE_PRIVATE_KEY=

# ── 소셜 로그인 — Google ───────────────────────────────────
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=

# ── 선택 ───────────────────────────────────────────────────
# Railway가 자동 주입. 로컬에서는 비워두면 4000 사용
PORT=
# 웹 클라이언트를 추가할 때만 설정. 비워두면 모든 origin 허용 (네이티브 전용 가정)
SOCKET_CORS_ORIGINS=
