server/

# Scripts and workspace files
scripts/
*.code-workspace

# Tests and CI (not needed by the app bundle)
__tests__/
jest.config.js
jest.setup.js
.maestro/
perf/
.github/
coverage/

# Documentation
CLAUDE.md
docs/
.text

# Local dev
.claude/

# Stay on the managed workflow — ignore local prebuild output (EAS only treats it as managed when absent)
ios/
android/
