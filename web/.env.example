# Railway backend the BFF talks to. The browser never sees this URL.
CAMOIM_API_URL=https://camoim-production.up.railway.app/api

# Public origin of the web app, used for canonical URLs and the Origin check on writes.
NEXT_PUBLIC_SITE_URL=https://camoimapp.com

# Socket.io connects straight to Railway — the only API origin the browser sees.
# No /api suffix: Socket.io attaches at the origin root.
NEXT_PUBLIC_SOCKET_ORIGIN=https://camoim-production.up.railway.app

# Google Maps JavaScript API key for the business and stay map.
# Create it in the same Google Cloud project as the app's Android/iOS keys, enable
# "Maps JavaScript API", and restrict it by HTTP referrer to the web origins only
# (https://camoimapp.com/*, https://*.vercel.app/*, http://localhost:3000/*).
# A referrer-restricted browser key is public by design; without one the map falls
# back to the list view.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
